generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// SQLite não suporta enums nativos → String + validação na aplicação.
// Roles: PATIENT | DOCTOR | ADMIN
model User {
  id            String           @id @default(cuid())
  phone         String?          @unique // E.164 sem "+", ex.: 5521980828309
  name          String
  role          String           @default("PATIENT")
  // Login social (Google). Nulos p/ usuários demo/seed e login por telefone.
  email         String?          @unique
  googleId      String?          @unique // "sub" do Google (id estável da conta)
  image         String? // URL do avatar do Google
  createdAt     DateTime         @default(now())
  // Preenchido pelo próprio paciente em Perfil → Saúde. Texto livre, visível
  // para o médico antes/durante a consulta (prontuário e sala de vídeo).
  condicoesCronicas String?
  alergias          String?
  conversations Conversation[]
  appointments  Appointment[]    @relation("PatientAppointments")
  urgencies     UrgencyRequest[] @relation("PatientUrgencies")
  documentos    Documento[]      @relation("PatientDocumentos")
  addresses     Address[]
  paymentCards  PaymentCard[]
  authTokens    AuthToken[]
  doctor        Doctor?
}

// Endereço do paciente (entrega de receita física, atendimento presencial).
model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Casa") // rótulo livre: Casa, Trabalho…
  cep        String
  logradouro String
  numero     String
  complemento String?
  bairro     String
  cidade     String
  uf         String
  principal  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Cartão de pagamento — DEMO. Guarda só o que é seguro exibir (bandeira +
// últimos 4 dígitos + validade + nome). NUNCA o número completo nem o CVV:
// num app real isso vai para o gateway (tokenização), nunca para o nosso banco.
model PaymentCard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     String // Visa, Mastercard, Elo…
  last4     String // últimos 4 dígitos
  holder    String // nome impresso
  expMonth  Int
  expYear   Int
  principal Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Specialty {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  icon      String
  keywords  String // JSON array de termos p/ triagem ("ansiedade","pânico"...)
  doctors   Doctor[]
  urgencies UrgencyRequest[]
}

model Doctor {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id])
  crm          String
  bio          String
  yearsExp     Int
  rating       Float              @default(4.8)
  priceCents   Int
  durationMin  Int                @default(30)
  mode         String             @default("VIDEO") // VIDEO | IN_PERSON | BOTH
  status       String             @default("ACTIVE") // PENDING | ACTIVE | SUSPENDED
  specialtyId  String
  specialty    Specialty          @relation(fields: [specialtyId], references: [id])
  availability AvailabilityRule[]
  appointments Appointment[]
  urgencies    UrgencyRequest[]
  documentos   Documento[]

  // Certificado digital A1 (ICP-Brasil) do médico, para assinar seus documentos.
  // Guardado CRIPTOGRAFADO (AES-256-GCM, ver modules/signing/cripto.ts): certPfx
  // são os bytes cifrados do .pfx; certSenha é a senha cifrada (base64).
  certPfx   Bytes?
  certSenha String?
  certNome  String? // nome do arquivo, só p/ exibição
  certEm    DateTime?
}

// Disponibilidade é REGRA, não tabela de slots (Etapa 6 §4):
// slots livres são calculados = regras − consultas ocupadas.
model AvailabilityRule {
  id       String @id @default(cuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])
  weekday  Int // 0=domingo ... 6=sábado
  startMin Int // minutos desde 00:00 (ex.: 480 = 08:00)
  endMin   Int
}

// Máquina de estados (Etapa 3 §6.4):
// AGUARDANDO_PAGAMENTO (hold TTL 15min) | CONFIRMADA | CONCLUIDA |
// CANCELADA | EXPIRADA | NO_SHOW
// NOTA prod/Postgres: índice UNIQUE parcial (doctorId,startsAt) via migration SQL.
// No MVP/SQLite a exclusividade é garantida na aplicação (transação).
model Appointment {
  id          String    @id @default(cuid())
  patientId   String
  patient     User      @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId    String
  doctor      Doctor    @relation(fields: [doctorId], references: [id])
  startsAt    DateTime
  durationMin Int
  mode        String    @default("VIDEO")
  status      String
  priceCents  Int
  holdUntil   DateTime?
  payment     Payment?
  urgency     UrgencyRequest?
  documentos  Documento[]
  createdAt   DateTime  @default(now())

  // Prontuário eletrônico — versão manual/grátis (sem IA, sem certificação
  // SBIS/CFM): o médico escreve, o paciente lê na tela da consulta. Fica null
  // até o médico preencher pela primeira vez.
  resumoClinico  String?
  condutas       String?
  prontuarioEmAt DateTime?

  // Lembretes já enviados, em minutos-antes (ex.: "1440,60,30"). Cada marco de
  // lembrete (24h/1h/30min) sai uma vez só; o cron consulta e atualiza isto.
  remindersSent String @default("")

  @@index([doctorId, startsAt])
  @@index([patientId, status])
}

// Chamado de urgência: o paciente abre, todos os médicos ativos da especialidade
// veem, e o PRIMEIRO que aceitar fica com ele (a corrida é resolvida na transação
// de aceite). Só depois do aceite existe consulta e cobrança.
model UrgencyRequest {
  id            String       @id @default(cuid())
  patientId     String
  patient       User         @relation("PatientUrgencies", fields: [patientId], references: [id])
  specialtyId   String
  specialty     Specialty    @relation(fields: [specialtyId], references: [id])
  description   String
  mode          String       @default("VIDEO")
  status        String       @default("BUSCANDO") // BUSCANDO | ACEITA | PAGA | CANCELADA | EXPIRADA
  expiresAt     DateTime
  doctorId      String?
  doctor        Doctor?      @relation(fields: [doctorId], references: [id])
  acceptedAt    DateTime?
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([status, specialtyId])
  @@index([patientId, createdAt])
}

model Payment {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  amountCents   Int
  feeCents      Int // take da plataforma (15%)
  method        String      @default("PIX")
  status        String      @default("PENDING") // PENDING | CONFIRMED | REFUNDED
  pixCode       String
  createdAt     DateTime    @default(now())
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  channel   String    @default("web") // web | whatsapp
  state     String    @default("{}") // JSON: máquina de estados do parser local
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String // user | clara | system
  content        String
  payload        String? // JSON: uiEvents (cards), quickReplies
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model UrgencyEvent {
  id             String   @id @default(cuid())
  conversationId String
  trigger        String // termo/frase que disparou
  level          Int // 1 = dicionário determinístico | 2 = sinalizado pelo modelo
  createdAt      DateTime @default(now())
}

// Código OTP de login do médico (WhatsApp). No MVP o código é mostrado na tela;
// quando a API do WhatsApp for conectada, o mesmo código é enviado por mensagem.
model OtpCode {
  id        String   @id @default(cuid())
  phone     String // E.164 sem "+"
  code      String // 6 dígitos
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// Token do e-mail de confirmação enviado no cadastro do médico. Clicar no link
// loga direto (sem precisar do OTP por WhatsApp) — vale uma vez, expira em 24h.
model EmailLoginToken {
  id        String   @id @default(cuid())
  token     String   @unique
  doctorId  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

// Token do e-mail de confirmação enviado no cadastro do paciente. Clicar no
// link loga direto (sem precisar do OTP por WhatsApp) — vale uma vez, expira em 24h.
model PatientEmailLoginToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

// Token de sessão para clientes que não têm cookie jar (app mobile React
// Native / Expo). O login por OTP emite um token opaco aqui; o app o guarda no
// secure-store e envia em "Authorization: Bearer <token>". A web continua
// usando o cookie httpOnly (sd_uid) — os dois caminhos convivem em getPatientUser().
model AuthToken {
  id        String   @id @default(cuid())
  token     String   @unique // opaco, aleatório (não é o userId em claro)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// Documento clínico enviado pelo médico ao paciente: receita, atestado, exame
// ou outro. Canal genérico — o "tipo" define o rótulo. Pode ter texto
// (médico digita) e/ou um arquivo anexado (PDF/imagem), guardado como bytes no
// próprio banco para não depender de storage externo nem tocar a árvore do
// projeto (o watcher do Turbopack). Amostra: sem assinatura digital ICP-Brasil.
model Documento {
  id            String       @id @default(cuid())
  tipo          String // RECEITA | ATESTADO | EXAME | OUTRO
  titulo        String
  conteudo      String       @default("") // corpo em texto (pode ser vazio se só arquivo)
  arquivo       Bytes? // PDF/imagem anexado (opcional)
  arquivoNome   String?
  arquivoMime   String?
  patientId     String
  patient       User         @relation("PatientDocumentos", fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  emitidoEm     DateTime     @default(now())
  lidoEm        DateTime? // quando o paciente abriu (nulo = "novo")

  // Assinatura digital (ICP-Brasil / PAdES). O arquivo é o PDF assinado.
  assinado      Boolean   @default(false)
  assinanteNome String?
  assinadoEm    DateTime?

  @@index([patientId, emitidoEm])
  @@index([doctorId, emitidoEm])
}
