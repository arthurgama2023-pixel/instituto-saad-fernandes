# IA — sem chave, a Clara roda em modo demo (parser local PT-BR)
ANTHROPIC_API_KEY=

# Banco — vazio = SQLite local (prisma/dev.db); postgres://... em produção
DATABASE_URL=

# Videochamada — Jitsi Meet (servidor público, sem conta/token).
# Trocar para um Jitsi self-hosted é só mudar JITSI_DOMAIN no código (src/app/sala/[id]/page.tsx).

# Login com Google (console.cloud.google.com → APIs e Serviços → Credenciais → OAuth 2.0)
# Redirect URI autorizado: http://localhost:3080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base pública do app — usada só p/ montar o redirect_uri enviado ao Google.
APP_URL=http://localhost:3080
# E-mails (separados por vírgula) que entram como MÉDICO ao logar pela área do médico.
AUTH_DOCTOR_EMAILS=

# Notificações por e-mail (Gmail SMTP). Precisa de "Senha de app" numa conta
# com verificação em 2 etapas: myaccount.google.com → Segurança → Senhas de app.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Segredo p/ proteger o endpoint de lembretes (/api/cron/lembretes?secret=...).
# Lembretes saem em 3 marcos fixos: 24h, 1h e 30min antes (ver a rota).
CRON_SECRET=

# Assinatura digital ICP-Brasil (PAdES). Certificado A1 (.pfx) em base64 + senha.
# Vazio = documentos não são assinados (segue como PDF sem assinatura).
# Gerar o base64 de um A1: `base64 -w0 seu-certificado.pfx`
ICP_PFX_BASE64=
ICP_PFX_PASSWORD=
# Chave p/ cifrar em repouso os certificados A1 por médico (AES-256-GCM).
# Necessária para o médico cadastrar o próprio certificado. Qualquer string longa.
APP_ENCRYPTION_KEY=
