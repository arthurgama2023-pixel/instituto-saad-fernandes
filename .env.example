# IA — sem chave, a Clara roda em modo demo (parser local PT-BR)
ANTHROPIC_API_KEY=

# Banco — vazio = SQLite local (prisma/dev.db); postgres://... em produção
DATABASE_URL=

# Clicksign — assinatura digital ICP-Brasil do receituário especial (item 05
# do roadmap). Sandbox: https://sandbox.clicksign.com · Produção: https://app.clicksign.com
# Gerado em Configurações → API, depois de cadastrar e confirmar por e-mail o
# "usuário da API" da conta.
CLICKSIGN_API_TOKEN=
CLICKSIGN_API_BASE_URL=

# Supabase Auth (login real por telefone/OTP). A anon key é pública (vai pro
# browser). Pegue em Project Settings → API no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
